# --- OPENAI: AI extraction and email drafting ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- EMAIL WORKFLOW: enable approvals and optional automatic offer ingestion ---
HITL_EMAIL_ENABLED=false
LIVE_EMAIL_INGESTION_ENABLED=false

# --- SMTP: send approval requests and approved wholesaler replies ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- IMAP: read approval replies and optionally incoming property offers ---
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
INGESTION_IMAP_FOLDER=INBOX

# --- APPROVAL: approvers, reply mailbox, deadline and polling ---
APPROVER_EMAILS=approver@example.com
APPROVAL_REPLY_TO=approval-inbox@example.com
APPROVAL_TIMEOUT_MINUTES=20
APPROVAL_POLL_INTERVAL_SECONDS=10

# --- BUYER: sender details used in reply drafts ---
BUYER_NAME=Example Buyer
BUYER_COMPANY=Example Investment Company

# --- DATABASE: persistent application records ---
DATABASE_URL=sqlite:///./data/deals.db